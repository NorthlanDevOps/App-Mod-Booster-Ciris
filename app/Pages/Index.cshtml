@page
@model IndexModel
@{
    ViewData["Title"] = "Expense Management";
}

@if (!string.IsNullOrEmpty(Model.ErrorMessage))
{
    <div class="alert alert-danger alert-dismissible fade show" role="alert">
        <h5 class="alert-heading">
            <i class="bi bi-exclamation-triangle-fill"></i> @Model.ErrorMessage
        </h5>
        <p class="mb-0">@Model.ErrorDetails</p>
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}

<div class="container-fluid">
    <div class="row mb-4">
        <div class="col">
            <h1 class="display-5 fw-bold mb-0">Expense Management</h1>
            <p class="text-muted">Manage and track your expenses</p>
        </div>
        <div class="col-auto">
            <a href="/Expenses/Create" class="btn btn-primary btn-lg">
                <i class="bi bi-plus-circle"></i> New Expense
            </a>
        </div>
    </div>

    <!-- Summary Cards -->
    <div class="row g-3 mb-4">
        @foreach (var item in Model.Summary)
        {
            <div class="col-md-3">
                <div class="card border-0 shadow-sm h-100">
                    <div class="card-body">
                        <h6 class="card-subtitle mb-2 text-muted text-uppercase small">@item.StatusName</h6>
                        <h3 class="card-title mb-1">£@item.TotalAmountInPounds.ToString("N2")</h3>
                        <p class="card-text text-muted small mb-0">@item.ExpenseCount expense(s)</p>
                    </div>
                </div>
            </div>
        }
    </div>

    <!-- Filters -->
    <div class="card border-0 shadow-sm mb-4">
        <div class="card-body">
            <form method="get" class="row g-3">
                <div class="col-md-4">
                    <label for="FilterUserId" class="form-label">User</label>
                    <select class="form-select" name="FilterUserId" id="FilterUserId">
                        <option value="">All Users</option>
                        @foreach (var user in Model.Users)
                        {
                            <option value="@user.UserId" selected="@(Model.FilterUserId == user.UserId)">@user.UserName</option>
                        }
                    </select>
                </div>
                <div class="col-md-3">
                    <label for="FilterStatusId" class="form-label">Status</label>
                    <select class="form-select" name="FilterStatusId" id="FilterStatusId">
                        <option value="">All Statuses</option>
                        @foreach (var status in Model.Statuses)
                        {
                            <option value="@status.StatusId" selected="@(Model.FilterStatusId == status.StatusId)">@status.StatusName</option>
                        }
                    </select>
                </div>
                <div class="col-md-3">
                    <label for="FilterCategoryId" class="form-label">Category</label>
                    <select class="form-select" name="FilterCategoryId" id="FilterCategoryId">
                        <option value="">All Categories</option>
                        @foreach (var category in Model.Categories)
                        {
                            <option value="@category.CategoryId" selected="@(Model.FilterCategoryId == category.CategoryId)">@category.CategoryName</option>
                        }
                    </select>
                </div>
                <div class="col-md-2">
                    <label class="form-label">&nbsp;</label>
                    <button type="submit" class="btn btn-primary w-100">
                        <i class="bi bi-funnel"></i> Filter
                    </button>
                </div>
            </form>
        </div>
    </div>

    <!-- Expenses Table -->
    <div class="card border-0 shadow-sm">
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-hover mb-0">
                    <thead class="table-light">
                        <tr>
                            <th>ID</th>
                            <th>Date</th>
                            <th>User</th>
                            <th>Category</th>
                            <th>Description</th>
                            <th class="text-end">Amount</th>
                            <th>Status</th>
                            <th class="text-center">Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (Model.Expenses.Any())
                        {
                            @foreach (var expense in Model.Expenses)
                            {
                                <tr>
                                    <td><span class="badge bg-secondary">@expense.ExpenseId</span></td>
                                    <td>@expense.ExpenseDate.ToString("dd MMM yyyy")</td>
                                    <td>@expense.UserName</td>
                                    <td>@expense.CategoryName</td>
                                    <td>@(expense.Description ?? "-")</td>
                                    <td class="text-end fw-bold">£@expense.AmountInPounds.ToString("N2")</td>
                                    <td>
                                        @if (expense.StatusName == "Draft")
                                        {
                                            <span class="badge bg-secondary">@expense.StatusName</span>
                                        }
                                        else if (expense.StatusName == "Submitted")
                                        {
                                            <span class="badge bg-warning text-dark">@expense.StatusName</span>
                                        }
                                        else if (expense.StatusName == "Approved")
                                        {
                                            <span class="badge bg-success">@expense.StatusName</span>
                                        }
                                        else if (expense.StatusName == "Rejected")
                                        {
                                            <span class="badge bg-danger">@expense.StatusName</span>
                                        }
                                    </td>
                                    <td class="text-center">
                                        <a href="/Expenses/Details?id=@expense.ExpenseId" class="btn btn-sm btn-outline-primary" title="View Details">
                                            <i class="bi bi-eye"></i>
                                        </a>
                                        @if (expense.StatusName == "Draft")
                                        {
                                            <a href="/Expenses/Edit?id=@expense.ExpenseId" class="btn btn-sm btn-outline-secondary" title="Edit">
                                                <i class="bi bi-pencil"></i>
                                            </a>
                                        }
                                    </td>
                                </tr>
                            }
                        }
                        else
                        {
                            <tr>
                                <td colspan="8" class="text-center text-muted py-4">
                                    No expenses found. <a href="/Expenses/Create">Create your first expense</a>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>

    <!-- Quick Links -->
    <div class="row g-3 mt-4">
        <div class="col-md-4">
            <div class="card border-0 shadow-sm">
                <div class="card-body text-center">
                    <i class="bi bi-file-earmark-plus display-4 text-primary mb-2"></i>
                    <h5 class="card-title">Create Expense</h5>
                    <p class="card-text text-muted small">Submit a new expense claim</p>
                    <a href="/Expenses/Create" class="btn btn-outline-primary">Go</a>
                </div>
            </div>
        </div>
        <div class="col-md-4">
            <div class="card border-0 shadow-sm">
                <div class="card-body text-center">
                    <i class="bi bi-chat-dots display-4 text-success mb-2"></i>
                    <h5 class="card-title">AI Chat Assistant</h5>
                    <p class="card-text text-muted small">Get help with your expenses</p>
                    <a href="/chat" class="btn btn-outline-success">Chat</a>
                </div>
            </div>
        </div>
        <div class="col-md-4">
            <div class="card border-0 shadow-sm">
                <div class="card-body text-center">
                    <i class="bi bi-code-square display-4 text-info mb-2"></i>
                    <h5 class="card-title">API Documentation</h5>
                    <p class="card-text text-muted small">Explore the REST API</p>
                    <a href="/swagger" class="btn btn-outline-info">View API</a>
                </div>
            </div>
        </div>
    </div>
</div>
